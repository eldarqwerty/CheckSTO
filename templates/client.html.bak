<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>CheckSTO — Фотоотчёт и смета ремонта</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
    .kz-plate-lg {
      display: inline-flex;
      align-items: stretch;
      border: 2px solid #0F172A;
      border-radius: 8px;
      overflow: hidden;
      background: #FFFFFF;
      font-weight: 800;
      letter-spacing: 0.05em;
      font-size: 15px;
      line-height: 1;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.12);
    }
    .kz-plate-lg-flag {
      background: #0284C7;
      color: #FDE047;
      padding: 6px 7px;
      font-size: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }
    .kz-plate-lg-main {
      padding: 7px 11px;
      color: #0F172A;
    }
    .kz-plate-lg-region {
      padding: 7px 9px;
      border-left: 2px solid #0F172A;
      color: #0F172A;
      background: #F8FAFC;
    }
  </style>
</head>
<body class="bg-slate-200/70 text-slate-900 antialiased min-h-screen">

  <!-- Mobile-first centered container (max 480px) -->
  <div class="max-w-[480px] mx-auto bg-[#F8FAFC] min-h-screen shadow-2xl flex flex-col relative pb-8">

    <!-- Top Dark Header -->
    <header class="bg-[#0F172A] text-white px-5 pt-5 pb-6 rounded-b-3xl shadow-lg">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center">
            <i data-lucide="shield-check" class="w-4 h-4 text-white"></i>
          </div>
          <div>
            <div class="font-extrabold text-sm leading-none tracking-tight">CheckSTO</div>
            <div class="text-[11px] text-slate-400 mt-0.5">СТО AutoMaster • Жезказган</div>
          </div>
        </div>
        <span id="header-status-pill" class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-200">Загрузка...</span>
      </div>

      <!-- Car Card inside Header -->
      <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 flex items-center justify-between gap-3">
        <div>
          <div id="car-model" class="text-base font-bold text-white leading-tight">—</div>
          <div class="text-xs text-slate-300 mt-1.5 flex items-center gap-3">
            <span class="inline-flex items-center gap-1">
              <i data-lucide="gauge" class="w-3.5 h-3.5 text-emerald-400"></i>
              <span id="car-mileage">0 км</span>
            </span>
            <span class="inline-flex items-center gap-1">
              <i data-lucide="clock" class="w-3.5 h-3.5 text-sky-400"></i>
              <span id="car-eta">—</span>
            </span>
          </div>
        </div>
        <div id="car-plate-box" class="shrink-0"></div>
      </div>
    </header>

    <!-- Loading / Not Found State -->
    <div id="not-found-box" class="hidden p-8 text-center space-y-3">
      <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center mx-auto">
        <i data-lucide="file-x-2" class="w-7 h-7"></i>
      </div>
      <h2 class="text-lg font-bold text-slate-900">Заказ-наряд не найден</h2>
      <p class="text-sm text-slate-500">Возможно, ссылка устарела или демо-данные были сброшены.</p>
    </div>

    <!-- Main Mobile Content -->
    <main id="client-main" class="px-4 pt-5 space-y-5 flex-1">

      <!-- 4-Step Progress Bar -->
      <section class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">Этап обслуживания</div>
        <div id="progress-steps" class="grid grid-cols-4 gap-1.5">
          <!-- Rendered via JS -->
        </div>
      </section>

      <!-- Photo Report Gallery -->
      <section class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <i data-lucide="camera" class="w-4 h-4 text-slate-700"></i>
            <h2 class="text-sm font-bold text-slate-900">Фотоотчёт мастера</h2>
          </div>
          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold">
            <button id="tab-photo-before" onclick="switchPhotoTab('before')" class="px-3 py-1 rounded-lg bg-white text-slate-900 shadow-xs">ДО (<span id="count-before">0</span>)</button>
            <button id="tab-photo-after" onclick="switchPhotoTab('after')" class="px-3 py-1 rounded-lg text-slate-500">ПОСЛЕ (<span id="count-after">0</span>)</button>
          </div>
        </div>

        <div id="photos-container" class="space-y-3">
          <!-- Photos rendered via JS -->
        </div>
      </section>

      <!-- Interactive Transparent Estimate -->
      <section class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Прозрачная смета ремонта</h2>
            <p class="text-xs text-slate-500 mt-0.5">Рекомендованные работы можно включить или отложить</p>
          </div>
        </div>

        <!-- Mandatory Items -->
        <div id="mandatory-block" class="space-y-2">
          <div class="text-[11px] font-bold uppercase tracking-wider text-rose-600 flex items-center gap-1.5">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
            Обязательно (безопасность и база)
          </div>
          <div id="mandatory-list" class="space-y-2"></div>
        </div>

        <!-- Recommended Items -->
        <div id="recommended-block" class="space-y-2 pt-2 border-t border-slate-100">
          <div class="text-[11px] font-bold uppercase tracking-wider text-sky-600 flex items-center gap-1.5">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            Рекомендации мастера (по желанию)
          </div>
          <div id="recommended-list" class="space-y-2"></div>
        </div>

        <!-- Total Summary -->
        <div class="pt-3 border-t border-slate-200 flex items-center justify-between">
          <div>
            <div class="text-xs text-slate-500 font-medium">Итого к оплате</div>
            <div class="text-[11px] text-slate-400">Фиксируется после согласования</div>
          </div>
          <div id="client-total-sum" class="text-2xl font-extrabold text-slate-900 tracking-tight">0 ₸</div>
        </div>
      </section>

      <!-- Approval Action / Digital Receipt -->
      <section id="approval-section" class="space-y-2.5">
        <!-- Rendered dynamically based on status -->
      </section>

      <!-- Digital Service Book -->
      <section class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-xs space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center">
            <i data-lucide="book-open-check" class="w-4 h-4"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">Цифровая сервисная книжка</h2>
            <p class="text-[11px] text-slate-500">Подтверждённая история повышает цену авто при продаже</p>
          </div>
        </div>

        <!-- Next TO Card -->
        <div class="rounded-xl bg-gradient-to-r from-violet-50 to-sky-50 border border-violet-200/70 p-3.5 flex items-center justify-between">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-violet-700">Следующее плановое ТО</div>
            <div id="next-to-date" class="text-sm font-extrabold text-slate-900 mt-0.5">—</div>
          </div>
          <div class="text-right">
            <div class="text-[11px] text-slate-500">Или по пробегу</div>
            <div id="next-to-mileage" class="text-sm font-extrabold text-violet-700 mt-0.5">—</div>
          </div>
        </div>

        <!-- Past Visits Timeline -->
        <div id="service-history-list" class="space-y-3">
          <!-- Rendered via JS -->
        </div>
      </section>

    </main>
  </div>

  <!-- Lightbox Modal for Photos -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-xs flex items-center justify-center p-4" onclick="closeLightbox()">
    <div class="max-w-lg w-full space-y-3" onclick="event.stopPropagation()">
      <div class="flex justify-end">
        <button onclick="closeLightbox()" class="w-9 h-9 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25">✕</button>
      </div>
      <img id="lightbox-img" src="" alt="" class="w-full rounded-2xl border border-slate-700 shadow-2xl" />
      <div id="lightbox-caption" class="bg-slate-900 text-slate-100 text-sm p-3.5 rounded-xl border border-slate-700 leading-relaxed"></div>
    </div>
  </div>

  <script>
    const ORDER_TOKEN = "{{ token }}";
    const STO_PHONE = "77010002020";
    let orderData = null;
    let selectedRecommendedIds = new Set();
    let currentPhotoTab = 'before';

    function formatTenge(value) {
      const num = Math.round(Number(value) || 0);
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₸';
    }

    function formatNumber(value) {
      const num = Math.round(Number(value) || 0);
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderKzPlateLarge(plate) {
      const parts = (plate || '').trim().toUpperCase().split(/\s+/);
      let main = plate;
      let region = '20';
      if (parts.length >= 2 && /^\d{2}$/.test(parts[parts.length - 1])) {
        region = parts.pop();
        main = parts.join(' ');
      }
      return `
        <div class="kz-plate-lg">
          <span class="kz-plate-lg-flag">KZ</span>
          <span class="kz-plate-lg-main">${escapeHtml(main)}</span>
          <span class="kz-plate-lg-region">${escapeHtml(region)}</span>
        </div>
      `;
    }

    async function loadClientOrder() {
      try {
        const res = await fetch(`/api/client/${ORDER_TOKEN}`);
        if (!res.ok) {
          document.getElementById('client-main').classList.add('hidden');
          document.getElementById('not-found-box').classList.remove('hidden');
          document.getElementById('header-status-pill').textContent = 'Не найдено';
          lucide.createIcons();
          return;
        }
        orderData = await res.json();
        selectedRecommendedIds = new Set(
          (orderData.items || [])
            .filter(i => i.category === 'recommended' && i.is_approved)
            .map(i => i.id)
        );
        renderAll();
      } catch (err) {
        console.error(err);
      }
    }

    function renderAll() {
      if (!orderData) return;

      document.getElementById('car-model').textContent = orderData.car_model;
      document.getElementById('car-mileage').textContent = `${formatNumber(orderData.mileage)} км`;
      document.getElementById('car-eta').textContent = orderData.estimated_completion;
      document.getElementById('car-plate-box').innerHTML = renderKzPlateLarge(orderData.plate_number);

      const statusLabels = {
        diagnostics: ['Диагностика', 'bg-blue-500/20 text-blue-200 border border-blue-400/30'],
        pending_approval: ['Ждёт согласования', 'bg-amber-500/20 text-amber-200 border border-amber-400/40'],
        approved: ['В работе', 'bg-emerald-500/20 text-emerald-200 border border-emerald-400/40'],
        completed: ['Готово к выдаче', 'bg-violet-500/25 text-violet-200 border border-violet-400/40'],
        rejected: ['Отклонено', 'bg-rose-500/25 text-rose-200 border border-rose-400/40']
      };
      const st = statusLabels[orderData.status] || statusLabels.diagnostics;
      const pill = document.getElementById('header-status-pill');
      pill.textContent = st[0];
      pill.className = `text-[11px] font-bold px-2.5 py-1 rounded-full ${st[1]}`;

      renderProgressBar();
      renderPhotos();
      renderEstimate();
      renderApprovalBlock();
      renderServiceBook();
      lucide.createIcons();
    }

    function renderProgressBar() {
      const steps = [
        { key: 'diagnostics', label: 'Диагностика' },
        { key: 'pending_approval', label: 'Согласование' },
        { key: 'approved', label: 'В работе' },
        { key: 'completed', label: 'Готово' }
      ];
      const orderIndex = { diagnostics: 0, pending_approval: 1, approved: 2, completed: 3, rejected: 1 };
      const activeIdx = orderIndex[orderData.status] ?? 0;

      document.getElementById('progress-steps').innerHTML = steps.map((s, i) => {
        const done = i < activeIdx || orderData.status === 'completed';
        const current = i === activeIdx && orderData.status !== 'completed';
        const barColor = orderData.status === 'rejected' && i === 1
          ? 'bg-rose-500'
          : done
            ? 'bg-emerald-500'
            : current
              ? 'bg-amber-500'
              : 'bg-slate-200';
        const textColor = done
          ? 'text-emerald-700 font-bold'
          : current
            ? 'text-slate-900 font-bold'
            : 'text-slate-400 font-medium';

        return `
          <div class="space-y-1.5">
            <div class="h-1.5 rounded-full ${barColor} transition-all"></div>
            <div class="text-[11px] text-center leading-tight ${textColor}">${s.label}</div>
          </div>
        `;
      }).join('');
    }

    function switchPhotoTab(tab) {
      currentPhotoTab = tab;
      document.getElementById('tab-photo-before').className = tab === 'before'
        ? 'px-3 py-1 rounded-lg bg-white text-slate-900 shadow-xs'
        : 'px-3 py-1 rounded-lg text-slate-500';
      document.getElementById('tab-photo-after').className = tab === 'after'
        ? 'px-3 py-1 rounded-lg bg-white text-slate-900 shadow-xs'
        : 'px-3 py-1 rounded-lg text-slate-500';
      renderPhotos();
    }

    function renderPhotos() {
      const photos = orderData.photos || [];
      const beforePhotos = photos.filter(p => p.photo_type === 'before');
      const afterPhotos = photos.filter(p => p.photo_type === 'after');
      document.getElementById('count-before').textContent = beforePhotos.length;
      document.getElementById('count-after').textContent = afterPhotos.length;

      const list = currentPhotoTab === 'before' ? beforePhotos : afterPhotos;
      const container = document.getElementById('photos-container');

      if (!list.length) {
        container.innerHTML = `
          <div class="rounded-xl bg-slate-50 border border-dashed border-slate-200 p-5 text-center text-xs text-slate-400">
            ${currentPhotoTab === 'before' ? 'Фотографии дефектов ещё не добавлены' : 'Фотографии выполненных работ появятся после завершения ремонта'}
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(p => `
        <div onclick="openLightbox('${escapeHtml(p.file_path)}', '${escapeHtml(p.caption)}')"
          class="cursor-pointer group rounded-2xl overflow-hidden border border-slate-200 bg-slate-900 shadow-xs active:scale-[0.99] transition-transform">
          <div class="relative">
            <img src="${escapeHtml(p.file_path)}" alt="${escapeHtml(p.caption)}" class="w-full h-48 object-cover" />
            <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-lg bg-slate-950/75 text-white text-[11px] font-semibold backdrop-blur-xs">
              Увеличить ⤢
            </div>
          </div>
          <div class="p-3 bg-white text-xs text-slate-700 leading-relaxed font-medium">
            ${escapeHtml(p.caption)}
          </div>
        </div>
      `).join('');
    }

    function openLightbox(src, caption) {
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox-caption').textContent = caption;
      document.getElementById('lightbox-modal').classList.remove('hidden');
    }

    function closeLightbox() {
      document.getElementById('lightbox-modal').classList.add('hidden');
    }

    function computeCurrentTotal() {
      if (!orderData) return 0;
      const isEditable = orderData.status === 'pending_approval' || orderData.status === 'diagnostics';
      if (!isEditable && (orderData.status === 'approved' || orderData.status === 'completed')) {
        return orderData.total_approved;
      }
      return (orderData.items || []).reduce((sum, item) => {
        if (item.category === 'mandatory') return sum + item.price;
        if (selectedRecommendedIds.has(item.id)) return sum + item.price;
        return sum;
      }, 0);
    }

    function toggleRecommended(itemId) {
      if (selectedRecommendedIds.has(itemId)) {
        selectedRecommendedIds.delete(itemId);
      } else {
        selectedRecommendedIds.add(itemId);
      }
      renderEstimate();
      renderApprovalBlock();
      lucide.createIcons();
    }

    function renderEstimate() {
      const items = orderData.items || [];
      const mandatory = items.filter(i => i.category === 'mandatory');
      const recommended = items.filter(i => i.category === 'recommended');
      const canToggle = orderData.status === 'pending_approval' || orderData.status === 'diagnostics';

      document.getElementById('mandatory-list').innerHTML = mandatory.map(i => `
        <div class="flex items-start justify-between gap-3 p-3 rounded-xl bg-rose-50/40 border border-rose-100">
          <div class="flex items-start gap-2.5">
            <div class="w-5 h-5 rounded-md bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</div>
            <div>
              <div class="text-sm font-semibold text-slate-900 leading-snug">${escapeHtml(i.title)}</div>
              <span class="inline-block mt-1 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-rose-100 text-rose-700">Критично</span>
            </div>
          </div>
          <div class="text-sm font-extrabold text-slate-900 shrink-0 whitespace-nowrap">${formatTenge(i.price)}</div>
        </div>
      `).join('') || `<div class="text-xs text-slate-400">Нет обязательных позиций</div>`;

      const recBlock = document.getElementById('recommended-block');
      if (!recommended.length) {
        recBlock.classList.add('hidden');
      } else {
        recBlock.classList.remove('hidden');
        document.getElementById('recommended-list').innerHTML = recommended.map(i => {
          const checked = canToggle ? selectedRecommendedIds.has(i.id) : i.is_approved;
          return `
            <label class="flex items-start justify-between gap-3 p-3 rounded-xl border transition-all ${checked ? 'bg-sky-50/50 border-sky-200' : 'bg-slate-50 border-slate-200 opacity-75'} ${canToggle ? 'cursor-pointer' : ''}">
              <div class="flex items-start gap-2.5">
                <input type="checkbox" ${checked ? 'checked' : ''} ${canToggle ? '' : 'disabled'}
                  onchange="toggleRecommended(${i.id})"
                  class="w-5 h-5 mt-0.5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 accent-emerald-600 shrink-0" />
                <div>
                  <div class="text-sm font-semibold text-slate-900 leading-snug ${checked ? '' : 'line-through text-slate-500'}">${escapeHtml(i.title)}</div>
                  <span class="inline-block mt-1 text-[10px] font-semibold px-2 py-0.5 rounded ${checked ? 'bg-sky-100 text-sky-700' : 'bg-slate-200 text-slate-600'}">
                    ${checked ? 'Включено в ремонт' : 'Отложено'}
                  </span>
                </div>
              </div>
              <div class="text-sm font-extrabold ${checked ? 'text-slate-900' : 'text-slate-400'} shrink-0 whitespace-nowrap">${formatTenge(i.price)}</div>
            </label>
          `;
        }).join('');
      }

      document.getElementById('client-total-sum').textContent = formatTenge(computeCurrentTotal());
    }

    function renderApprovalBlock() {
      const box = document.getElementById('approval-section');
      const total = computeCurrentTotal();
      const waQuestion = `Здравствуйте! У меня вопрос по заказ-наряду ${orderData.plate_number} (${orderData.car_model}).`;
      const waLink = `https://wa.me/${STO_PHONE}?text=${encodeURIComponent(waQuestion)}`;

      if (orderData.status === 'pending_approval' || orderData.status === 'diagnostics') {
        box.innerHTML = `
          <button id="btn-approve" onclick="approveOrder()"
            class="w-full py-4 px-5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-extrabold text-base shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2">
            <span>✅ Согласовать ремонт на ${formatTenge(total)}</span>
          </button>
          <div class="grid grid-cols-2 gap-2">
            <button onclick="rejectOrder()"
              class="py-3 px-3 rounded-xl bg-white hover:bg-rose-50 text-rose-700 border border-rose-200 text-xs font-bold transition-colors">
              Отклонить смету
            </button>
            <a href="${waLink}" target="_blank"
              class="py-3 px-3 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors">
              <i data-lucide="message-circle" class="w-4 h-4 text-emerald-600"></i>
              Связаться в WhatsApp
            </a>
          </div>
        `;
      } else if (orderData.status === 'approved' || orderData.status === 'completed') {
        box.innerHTML = `
          <div class="rounded-2xl bg-emerald-50 border-2 border-emerald-500/40 p-4 space-y-2 shadow-xs">
            <div class="flex items-center gap-2.5 text-emerald-800">
              <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                <i data-lucide="badge-check" class="w-5 h-5"></i>
              </div>
              <div>
                <div class="text-sm font-extrabold">Цифровой чек согласования</div>
                <div class="text-xs font-semibold text-emerald-700">Сумма зафиксирована: ${formatTenge(orderData.total_approved)}</div>
              </div>
            </div>
            <div class="text-xs text-emerald-900 bg-white/80 rounded-xl p-3 border border-emerald-200/80 leading-relaxed">
              Согласовано онлайн <strong>${escapeHtml(orderData.approved_at || 'сегодня')}</strong> — защита от споров при выдаче автомобиля.
            </div>
          </div>
        `;
      } else if (orderData.status === 'rejected') {
        box.innerHTML = `
          <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 space-y-3">
            <div class="text-sm font-bold text-rose-800">Вы отклонили предложенную смету</div>
            <p class="text-xs text-rose-700">Мастер уже получил уведомление и не приступит к работам без вашего подтверждения.</p>
            <a href="${waLink}" target="_blank"
              class="w-full py-2.5 px-4 rounded-xl bg-[#25D366] text-white text-xs font-bold flex items-center justify-center gap-1.5">
              <i data-lucide="message-circle" class="w-4 h-4"></i>
              Обсудить с мастером в WhatsApp
            </a>
          </div>
        `;
      }
    }

    async function approveOrder() {
      const btn = document.getElementById('btn-approve');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Фиксируем согласование...';
      }
      const res = await fetch(`/api/client/${ORDER_TOKEN}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved_item_ids: Array.from(selectedRecommendedIds) })
      });
      if (res.ok) {
        orderData = await res.json();
        renderAll();
      }
    }

    async function rejectOrder() {
      if (!confirm('Отклонить текущую смету ремонта? Мастер свяжется с вами для уточнения.')) return;
      const res = await fetch(`/api/client/${ORDER_TOKEN}/reject`, { method: 'POST' });
      if (res.ok) {
        orderData = await res.json();
        renderAll();
      }
    }

    function renderServiceBook() {
      document.getElementById('next-to-date').textContent = orderData.next_service_date || 'Через 6 мес.';
      document.getElementById('next-to-mileage').textContent = `${formatNumber(orderData.next_service_mileage)} км`;

      const history = orderData.service_history || [];
      const list = document.getElementById('service-history-list');
      if (!history.length) {
        list.innerHTML = `<div class="text-xs text-slate-400 text-center py-3">Это первый цифровой визит данного автомобиля.</div>`;
        return;
      }

      list.innerHTML = history.map(h => `
        <div class="relative pl-5 border-l-2 border-slate-200 pb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-violet-500 absolute -left-[6px] top-1 ring-4 ring-white"></span>
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">${escapeHtml(h.visit_date)} • ${formatNumber(h.mileage)} км</span>
            <span class="font-extrabold text-slate-700">${formatTenge(h.total_cost)}</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">${escapeHtml(h.summary)}</p>
        </div>
      `).join('');
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadClientOrder();
    });
  </script>
</body>
</html>
